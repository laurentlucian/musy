{
  "name": "musy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "release": "wrangler deploy",
    "deploy": "bun run build && bun run release",
    "typecheck": "react-router typegen && tsc -b",
    "format": "biome format --write ./app",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply -c ./wrangler.jsonc --remote musy",
    "typegen": "wrangler types -c ./wrangler.jsonc --env-interface Env",
    "env": "dotenv -e .env"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-fetch/fetch": "1.1.21",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@zip.js/zip.js": "2.11.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.1",
    "lucide-react": "0.546.0",
    "maplibre-gl": "6.7.0",
    "motion": "12.23.26",
    "nanoid": "5.1.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.11.0",
    "remix-auth": "4.2.0",
    "remix-auth-oauth2": "3.4.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vite-plugin": "1.54.4",
    "@react-router/dev": "7.11.0",
    "@react-router/fs-routes": "7.11.0",
    "@types/node": "22.14.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-tsconfig-paths": "6.0.3"
  },
  "overrides": {
    "use-sync-external-store": "1.5.0"
  }
}
